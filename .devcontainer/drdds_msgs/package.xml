<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<!--
  A stand-in for DEEP Robotics' drdds holding only the messages this package reads
  (BatteryData, BatteryDataValue, MetaType), for developing this repo on its own (Dev Container
  and CI). import_drdds_msgs.sh fetches them from the sdk_deploy commit SyncAI-Robot-Workspace
  pins in third-party-sparse.repos, so the types are the robot's. SyncAI-Robot-Workspace builds
  the whole drdds and never uses this one.
-->
<package format="3">
  <name>drdds</name>
  <version>0.0.0</version>
  <description>drdds BatteryData messages only (Dev Container stand-in)</description>
  <maintainer email="andy_tseng@syncrobotic.com">andy_tseng</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>
  <depend>builtin_interfaces</depend>
  <exec_depend>rosidl_default_runtime</exec_depend>
  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
