# syncai_common (SyncAI-Robot-Interface): the msg / srv / action shared by the whole syncai stack.
# Pulled in with vcstool rather than a submodule, same as SyncAI-Robot-Backend and SyncAI-Robot-Workspace.
#
#   make interface          # first import into src/syncai_common
#   make interface-update   # re-checkout after changing the version below (--force, overwrites local changes)
#
# Paths are relative to the vcs import target directory and the key below already includes `src/`,
# so run it from the workspace root (/workspace in the container) without an extra `src` argument,
# or it lands in src/src/.
#
# HTTPS rather than SSH: the repo is public, so the container needs no keys and CI can pull it directly
# (the backend / workspace interface.repos files do the same).
#
# src/syncai_common/ is gitignored: it is another git repo's working tree. Change messages there
# and commit them there, not in this repo; the next --force import overwrites anything uncommitted.
#
# Track dev (that repo's default branch): main lags behind dev, and importing main once came up a srv short.
repositories:
  src/syncai_common:
    type: git
    url: https://github.com/chungweeeei/SyncAI-Robot-Interface.git
    version: dev
