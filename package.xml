<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>syncai_driver_manager</name>
  <version>0.1.0</version>
  <description>Bridges the robot low-level controller (UDP) to ROS 2 topics</description>
  <maintainer email="andy_tseng@syncrobotic.com">andy_tseng</maintainer>
  <license>Apache-2.0</license>

  <depend>rclrs</depend>
  <depend>rosidl_runtime_rs</depend>
  <depend>syncai_common</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_cargo</build_type>
  </export>
</package>
